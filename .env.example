# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will NEVER be committed

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Database (MongoDB)
# ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/escrowx?retryWrites=true&w=majority

# ──────────────────────────────────────────────
# Escrow Engine API (if deploying backend separately)
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ──────────────────────────────────────────────
# Auth / JWT (for future use)
# ──────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_key

# ──────────────────────────────────────────────
# Payment Gateway (e.g. Stripe — for production)
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
